# ============================================================================
# Environment Variables Template
# ============================================================================
# Copy this file to .env and update with your actual values.
# NEVER commit .env to version control.
#
# Each deployment (staging vs production) MUST ship its own explicit values —
# the code reads these from the environment and does NOT hardcode environment
# specific domains/IPs as fallbacks. Changing any list below requires NO code
# edit; just redeploy with the new value.
# ============================================================================

# ---- Django core -----------------------------------------------------------
# FAIL-SAFE: DEBUG defaults to False when unset. Never enable in production.
DEBUG=False                                  # dev: DEBUG=True

# Secret key: use a strong, unique value per environment.
# REQUIRED — the app refuses to start (raises ImproperlyConfigured) without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here-change-this-in-production

DJANGO_SETTINGS_MODULE=smmsproject.settings

# Comma-separated list of host/domain names the app will serve.
# staging example: ALLOWED_HOSTS=staging.ditronics.co.tz
# prod example:    ALLOWED_HOSTS=adhimkitchen.ditronics.co.tz,www.adhimkitchen.ditronics.co.tz,backend1.ditronics.co.tz
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# Number of trusted reverse-proxy hops represented in X-Forwarded-For.
# Keep 0 unless requests always pass through a trusted proxy that overwrites
# the forwarding headers. Direct single-proxy Nginx deployments typically use 1.
NUM_PROXIES=0

# Optional school-system integration API and scheduled CSV adapter import.
INTEGRATION_RATE=120/min
CELERY_TIMEZONE=Africa/Dar_es_Salaam
SCHOOL_SYSTEM_ADAPTER=csv
SCHOOL_SYSTEM_SOURCE=school-system
# Set after creating an integration key; unset disables scheduled sync.
SCHOOL_SYSTEM_INTEGRATION_KEY_ID=
SCHOOL_SYSTEM_SYNC_HOUR=3
SCHOOL_SYSTEM_SYNC_MINUTE=0
SCHOOL_SYSTEM_SYNC_DRY_RUN=false
SCHOOL_SYSTEM_STUDENTS_CSV=
SCHOOL_SYSTEM_PARENTS_CSV=
SCHOOL_SYSTEM_CLASSES_CSV=

# ---- CORS / CSRF origins ---------------------------------------------------
# Comma-separated origins (scheme://host[:port]). Empty = closed by default.
# staging example: CORS_ALLOWED_ORIGINS=https://staging-app.ditronics.co.tz
# prod example:    CORS_ALLOWED_ORIGINS=https://adhimkitchen.ditronics.co.tz,https://www.adhimkitchen.ditronics.co.tz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=

# ---- HTTPS / security headers ----------------------------------------------
# If Nginx (or another proxy) already redirects HTTP->HTTPS at the edge, leave
# SECURE_SSL_REDIRECT=False. Enable it only if the app itself terminates TLS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Optional HSTS. Set SECURE_HSTS_SECONDS (e.g. 31536000) to enable; recommend
# starting with a low value in staging and ramping up in production.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ---- Database --------------------------------------------------------------
DB_NAME=smmsdb
DB_USER=postgres
# REQUIRED — the app refuses to start (raises ImproperlyConfigured) without it.
DB_PASSWORD=your-secure-password-here
DB_HOST=db
DB_PORT=5432

# ---- Redis / Celery --------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
SCAN_THROTTLE_RATE=120
AUDIT_RETENTION_DAYS=365

# ---- Optional SMS notifications -------------------------------------------
# `log` is safe for local development; use `twilio` or `beem` when configured.
SMS_PROVIDER=log
SMS_DAILY_LIMIT=3
SMS_MONTHLY_LIMIT=10000
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SENDER_ID=SMMS

# ---- Firebase (FCM push) ---------------------------------------------------
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_SENDER_ID=your-firebase-sender-id
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to the service-account JSON used by the notification task.
# FIREBASE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# ---- Email -----------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# ---- API BASE URL --------------------------------------------------------
# Base URL for the API (used for email links, etc.)
# Override via API_BASE_URL env var; default http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000

# ---- Public branding and optional feature flags ---------------------------
APP_NAME=Student Meal Management System
APP_SHORT_NAME=SMMS
CURRENCY_CODE=TZS
CURRENCY_SYMBOL=TSh
CURRENCY_DECIMALS=2
APP_LOCALE=en-TZ
STOCK_ENFORCED=False
MENU_ENFORCED=False
SPONSOR_FALLBACK_TO_WALLET=True
ANALYTICS_DEFAULT_RANGE_DAYS=30
ANALYTICS_MAX_RANGE_DAYS=366
INSIGHT_REVERSAL_LIMIT=10
INSIGHT_VARIANCE_LIMIT=10000.00
RFID_BALANCE_FLOOR=-500.00
PENALTY_FEE=500.00
STRIKE_LIMIT=10
STRIKE_RESET_ON_DEPOSIT=False
# JSON object maps feature keys to deployment defaults. Keys become the
# supported flag catalog; database values override these defaults.
FEATURES_DEFAULT={"ANALYTICS":false,"INSIGHTS":false,"LEDGER_UI":false,"PAYMENTS":true,"MENU":true,"PREORDERS":false,"SPONSORSHIP":false,"INTEGRATIONS":false,"STOCK":false,"PARENT_LIMITS":false,"NFC_SCAN":false}

# ---- Parent pre-orders ----------------------------------------------------
PREORDER_TIME_ZONE=Africa/Dar_es_Salaam
PREORDER_CUTOFF_TIME=18:00
PREORDER_MAX_DAYS_AHEAD=1
PREORDER_MAX_QTY_PER_ITEM=1
PREORDER_NOSHOW_FEE=0.00
PREORDER_REMINDER_ENABLED=False

# ---- Optional: Superuser creation (development only) -----------------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=admin123
