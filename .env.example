# ============================================================================
# Environment Variables Template
# ============================================================================
# Copy this file to .env and update with your actual values.
# NEVER commit .env to version control.
#
# Each deployment (staging vs production) MUST ship its own explicit values —
# the code reads these from the environment and does NOT hardcode environment
# specific domains/IPs as fallbacks. Changing any list below requires NO code
# edit; just redeploy with the new value.
# ============================================================================

# ---- Django core -----------------------------------------------------------
# FAIL-SAFE: DEBUG defaults to False when unset. Never enable in production.
DEBUG=False                                  # dev: DEBUG=True

# Secret key: use a strong, unique value per environment.
SECRET_KEY=your-secret-key-here-change-this-in-production

DJANGO_SETTINGS_MODULE=smmsproject.settings

# Comma-separated list of host/domain names the app will serve.
# staging example: ALLOWED_HOSTS=staging.ditronics.co.tz
# prod example:    ALLOWED_HOSTS=adhimkitchen.ditronics.co.tz,www.adhimkitchen.ditronics.co.tz,backend1.ditronics.co.tz
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ---- CORS / CSRF origins ---------------------------------------------------
# Comma-separated origins (scheme://host[:port]). Empty = closed by default.
# staging example: CORS_ALLOWED_ORIGINS=https://staging-app.ditronics.co.tz
# prod example:    CORS_ALLOWED_ORIGINS=https://adhimkitchen.ditronics.co.tz,https://www.adhimkitchen.ditronics.co.tz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=

# ---- HTTPS / security headers ----------------------------------------------
# If Nginx (or another proxy) already redirects HTTP->HTTPS at the edge, leave
# SECURE_SSL_REDIRECT=False. Enable it only if the app itself terminates TLS.
SECURE_SSL_REDIRECT=False

# Optional HSTS. Set SECURE_HSTS_SECONDS (e.g. 31536000) to enable; recommend
# starting with a low value in staging and ramping up in production.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ---- Database --------------------------------------------------------------
DB_NAME=smmsdb
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_HOST=db
DB_PORT=5432

# ---- Redis / Celery --------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0

# ---- Firebase (FCM push) ---------------------------------------------------
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_SENDER_ID=your-firebase-sender-id
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to the service-account JSON used by the notification task.
# FIREBASE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# ---- Email -----------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# ---- Optional: Superuser creation (development only) -----------------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=admin123
